{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FraudX: backend",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--timeout-graceful-shutdown",
        "2"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "fraudx"
      }
    },
    {
      "label": "FraudX: frontend",
      "type": "process",
      "command": "npm.cmd",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "fraudx"
      },
      "args": [
        "run",
        "dev"
      ]
    },
    {
      "label": "FraudX: start all",
      "dependsOn": [
        "FraudX: backend",
        "FraudX: frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "FraudX: run tests",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "backend/tests",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}