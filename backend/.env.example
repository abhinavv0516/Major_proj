# Copy to backend/.env and adjust. Values already set in the environment win over this file.

# ── Database ─────────────────────────────────────────────────────────────────
# Local demo (file lives in backend/, whatever folder you start uvicorn from):
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# PostgreSQL (docker compose up db, then `cd backend && alembic upgrade head`):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fraud_db
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── Redis (queue for /api/transactions/async, worker -> live feed relay) ─────
REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Demo login (demo@fraudx.dev / demo1234). Set to false for any real deployment.
SEED_DEMO_USER=true

# ── Model (defaults come from ml-model/model_card.json written by train.py) ──
# FRAUD_THRESHOLD=0.5
# HIGH_RISK_THRESHOLD=0.8
# MODEL_VERSION=xgboost-custom

# ── CORS (comma-separated frontend origins) ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MLFLOW_TRACKING_URI=http://localhost:5000
